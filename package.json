{
  "name": "printcat",
  "version": "1.3.2",
  "description": "Premium, feature-rich cross-platform screenshot tool",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "build": "electron-builder --publish never",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "build:linux:pacman": "electron-builder --linux tar.xz --publish never",
    "build:linux:rpm": "electron-builder --linux rpm --publish never",
    "publish": "electron-builder --publish always",
    "publish:win": "electron-builder --win --publish always",
    "publish:mac": "electron-builder --mac --publish always",
    "publish:linux": "electron-builder --linux --publish always"
  },
  "keywords": [
    "screenshot",
    "printcat",
    "windows",
    "macos",
    "linux",
    "cross-platform",
    "electron"
  ],
  "author": {
    "name": "Aeeryin",
    "email": "artisticamente.official@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aeeryin/Printcat.git"
  },
  "license": "MIT",
  "build": {
    "appId": "com.printcat.app",
    "productName": "Printcat",
    "publish": [
      {
        "provider": "github",
        "owner": "aeeryin",
        "repo": "Printcat",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icons/main.png",
      "artifactName": "Printcat-${version}-windows.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "src/assets/icons/main.png",
      "identity": null,
      "artifactName": "Printcat-${version}-macos.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.xz",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icons/main.png",
      "category": "Utility",
      "maintainer": "Aeeryin <aeeryin@gmail.com>",
      "artifactName": "Printcat-${version}-linux.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "Printcat-${version}-windows.${ext}",
      "shortcutName": "Printcat"
    },
    "rpm": {
      "artifactName": "Printcat-${version}-linux.${ext}"
    },
    "files": [
      "**/*",
      "!node_modules/.cache/**",
      "!dist/**",
      "!out/**",
      "!release/**",
      "!build/**",
      "!.github/**",
      "!.git/**",
      "!website/**",
      "!*.log"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "gifenc": "^1.0.3",
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "electron": "^31.1.0",
    "electron-builder": "^24.13.3"
  }
}
